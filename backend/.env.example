# ==========================================
# MCIP - Multimodal Construction Intelligence Platform
# Backend Environment Configuration
# ==========================================

# xAI Grok API Configuration (REQUIRED for Live AI Mode)
# Leave blank or set AI_DEMO_MODE=true to run in deterministic offline demo mode
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-1212
GROK_VISION_MODEL=grok-2-vision-1212

# AI Operation Mode
# Set to true to force deterministic mock responses (ideal for testing, no quota usage)
AI_DEMO_MODE=false

# Database Configuration (SQLite default for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./construction.db
# Example PostgreSQL for Render / Supabase / Neon:
# DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/dbname

# CORS Allowed Origins (Comma-separated or list)
# FRONTEND_URL=http://localhost:5173
